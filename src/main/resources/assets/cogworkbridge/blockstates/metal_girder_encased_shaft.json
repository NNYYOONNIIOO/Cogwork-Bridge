{
  "multipart": [
    {"when": {"axis": "z"}, "apply": {"model": "create:metal_girder_encased_shaft/block"}},
    {"when": {"axis": "x"}, "apply": {"model": "create:metal_girder_encased_shaft/block", "y": 90}},
    {"when": {"axis": "y"}, "apply": {"model": "create:metal_girder_encased_shaft/block", "x": 90}},
    {"when": {"top": "true"}, "apply": {"model": "create:metal_girder_encased_shaft/block_top"}},
    {"when": {"bottom": "true"}, "apply": {"model": "create:metal_girder_encased_shaft/block_bottom"}}
  ]
}
