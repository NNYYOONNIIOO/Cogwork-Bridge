.gradle
**/build/
!src/**/build/
run/
out/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# IDEA config
.idea


# Build / run logs
*.log

# Local run data (worlds, options, screenshots)
run/

# Local JVM scratch files and dependency jars
.jvm-temp/
$null
/libs/*.jar
!/libs/ponder-legacy-1.7.1.jar
/assets/

# Internal task history and local audits
/docs/todo.md
/docs/HANDOFF*.md
/docs/history/
/docs/*audit*
/docs/item-function-*

# Python cache
__pycache__/
*.pyc

# Local maintenance tools
/tools/
